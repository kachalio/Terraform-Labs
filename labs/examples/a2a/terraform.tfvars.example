# a2a lab configuration template
# Copy this file to terraform.tfvars in your deployment root.
# Terraform does not automatically load the .example file.
# Set required inputs below; optional assignments show the actual defaults.
# Uncomment only the optional settings you want to override.
# Never put real passwords in this template; use TF_VAR_* environment variables.
# Choose distinct resource names for each deployment, including globally unique storage names.
# Source of truth: variables.tf. Update this template when inputs or defaults change.

# Required inputs (no defaults)

# REQUIRED: The admin username for the virtual machine
vm_admin_username = "azureuser"

# REQUIRED: The admin password for the virtual machine
# Sensitive: set TF_VAR_vm_admin_password; leave the assignment below commented.
# vm_admin_password = "<provided through TF_VAR_vm_admin_password>"

# Optional inputs (defaults, commented out)

# The name of the source resource group
# source_rg_name = "Lab-ASR-Source"

# The region of the source resource group
# source_location = "eastus2"

# The name of the target resource group
# target_rg_name = "Lab-ASR-Target"

# The region of the target resource group
# target_location = "westus2"

# Whether to create a NAT gateway for the subnets
# create_nat_gateway = false

# The name of the source virtual network
# source_vnet_name = "Lab-ASR-Source-VNet"

# The address space of the source virtual network
# source_vnet_address_space = ["10.0.0.0/16"]

# The name of the source subnet
# source_subnet_name = "default"

# The address prefixes of the source subnet
# source_subnet_address_prefixes = ["10.0.0.0/24"]

# The name of the target virtual network
# target_vnet_name = "Lab-ASR-Target-VNet"

# The address space of the target virtual network
# target_vnet_address_space = ["10.1.0.0/16"]

# The name of the target subnet
# target_subnet_name = "default"

# The address prefixes of the target subnet
# target_subnet_address_prefixes = ["10.1.0.0/24"]

