# The name of the Recovery Services Vault
# rsv_name = "tf-asr-vault"

# The SKU of the Recovery Services Vault
# rsv_sku = "Standard"

# The storage mode type of the Recovery Services Vault
# rsv_storage_mode_type = "LocallyRedundant"

# The name of the cache storage account
# cache_storage_name = "tfasrcachestorage"

# The tier of the cache storage account
# cache_storage_account_tier = "Standard"

# The replication type of the cache storage account
# cache_storage_replication_type = "LRS"

# Whether to create and attach a public IP address to the VM
# create_public_ip = false

# Whether secure boot is enabled for the VMs
# secure_boot_enabled = false

# The number of Linux VMs to create
# linux_vm_count = 1

# The prefix for the Linux VM name
# linux_vm_name_prefix = "lin-vm"

# The size of the virtual machine
# vm_size = "Standard_D2s_v5"

# The image reference for the Linux VM
# linux_vm_image = {
#   publisher = "Canonical"
#   offer     = "UbuntuServer"
#   sku       = "18.04-LTS"
#   version   = "latest"
# }

# The storage account type for the Linux VM OS disk
# linux_vm_os_disk_storage_account_type = "Standard_LRS"

# Whether secure boot is enabled for the Linux VMs
# secure_boot_enabled_linux = true

# The prefix for the Windows VM name
# windows_vm_name_prefix = "win-vm"

# The number of Windows VMs to create
# windows_vm_count = 1

# The image reference for the Windows VM
# windows_vm_image = {
#   publisher = "MicrosoftWindowsServer"
#   offer     = "WindowsServer"
#   sku       = "2025-datacenter-g2"
#   version   = "latest"
# }

# The storage account type for the Windows VM OS disk
# windows_vm_os_disk_storage_account_type = "Standard_LRS"

# Whether secure boot is enabled for the Windows VMs
# secure_boot_enabled_windows = true

# Flag to enable or disable ASR resources
# enable_replication = false
